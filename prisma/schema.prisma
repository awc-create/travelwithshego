// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HeroHome {
  id          String   @id @default(cuid())
  key         String   @unique @default("home")
  imageSrc    String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeMission {
  id             String   @id @default(cuid())
  key            String   @unique @default("mission")
  title          String
  description    String
  familiesHoused Int      @default(0)
  childrenInCare Int      @default(0)
  mealsServed    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomeGallery {
  id        String   @id @default(cuid())
  key       String   @unique @default("gallery")
  imageUrls String[]
  title     String?
  subtitle  String?
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeTestimonial {
  id        String   @id @default(cuid())
  key       String   @unique @default("testimonial")
  quote     String
  author    String
  role      String?
  avatarSrc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeDonation {
  id        String   @id @default(cuid())
  key       String   @unique @default("donation")
  title     String
  subtitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutUs {
  id          String   @id @default(cuid())
  key         String   @unique @default("about")
  title       String
  description String
  bullets     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactPage {
  id             String   @id @default(cuid())
  key            String   @unique @default("contact")
  title          String
  description    String
  submitLabel    String
  successMessage String
  recipientEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  size      Int      @default(0)
  type      String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ─────────────────────────────────────────────
// NEW: Donations + Auction items
// ─────────────────────────────────────────────

model AuctionItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  imageUrl    String?
  pricePence  Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  endsAt      DateTime?

  // NEW
  closed      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations   Donation[]
  bids        AuctionBid[]   // 👈 NEW relation
}

model AuctionBid {
  id            String      @id @default(cuid())
  auctionItemId String
  auctionItem   AuctionItem @relation(fields: [auctionItemId], references: [id])

  amountPence   Int
  email         String
  name          String?
  isWinner      Boolean     @default(false)  // 👈 for marking who won

  createdAt     DateTime    @default(now())

  @@index([auctionItemId])
  @@index([createdAt])
}

model Donation {
  id                      String   @id @default(cuid())
  amountPence             Int
  currency                String           @default("GBP")
  status                  DonationStatus   @default(PENDING)
  frequency               DonationFrequency @default(ONCE)
  type                    DonationType     @default(DIRECT)

  // Baraawe is your *single* project, so no Project table.
  // You can still distinguish direct vs auction via type + relation below.
  email                   String
  name                    String?
  message                 String?

  auctionItemId           String?
  auctionItem             AuctionItem?     @relation(fields: [auctionItemId], references: [id])

  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  stripeCustomerId        String?

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([createdAt])
  @@index([email])
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  REFUNDED
  FAILED
}

enum DonationFrequency {
  ONCE
  MONTHLY
}

enum DonationType {
  DIRECT   // from the main donation page
  AUCTION  // tied to a specific AuctionItem
}