// prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model HeroHome {
  id          String   @id @default(cuid())
  key         String   @unique @default("home")
  imageSrc    String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HomeMission {
  id             String   @id @default(cuid())
  key            String   @unique @default("mission")
  title          String
  description    String
  familiesHoused Int      @default(0)
  childrenInCare Int      @default(0)
  mealsServed    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HomeGallery {
  id        String   @id @default(cuid())
  key       String   @unique @default("gallery")
  imageUrls String[]
  title     String?   // ← new (optional)
  subtitle  String?   // ← new (optional)
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeTestimonial {
  id        String   @id @default(cuid())
  key       String   @unique @default("testimonial")
  quote     String
  author    String
  role      String?
  avatarSrc String?  // optional headshot
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeDonation {
  id        String   @id @default(cuid())
  key       String   @unique @default("donation")
  title     String
  subtitle  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutUs {
  id          String   @id @default(cuid())
  key         String   @unique @default("about")
  title       String
  description String
  bullets     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactPage {
  id             String   @id @default(cuid())
  key            String   @unique @default("contact")
  title          String
  description    String
  submitLabel    String
  successMessage String
  recipientEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  size      Int      @default(0)
  type      String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}
